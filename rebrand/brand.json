  "append": [
    {
      "file": ".gitignore",
      "marker": "# Brand sources are kept outside the repo",
      "lines": [
        "",
        "# Brand sources are kept outside the repo",
        "/brand/",
        "",
        "# Local/generated files (repo audit)",
