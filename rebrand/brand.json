      ]
    },
    {
      "file": ".gitattributes",
      "marker": "# Mailflow (rebrand/apply.py)",
      "lines": [
        "",
        "# Mailflow (rebrand/apply.py): files we replace whole keep our version in a merge.",
        "# Needs `git config merge.ours.driver true` once per clone (docs/UPSTREAM.md).",
        "README.md merge=ours",
        "CLAUDE.md merge=ours",
        "assets/app-icon/** merge=ours"
      ]
    }
